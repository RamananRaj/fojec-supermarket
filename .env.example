# Copy to .env.local (never committed) and fill in. Add the same names in
# Vercel -> Project -> Settings -> Environment Variables (not the sandbox seed token).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://whpzgdoyqwutkpxvavtf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Square: "sandbox" for testing, "production" for the real shop
SQUARE_ENVIRONMENT=sandbox
# From Square Developer console -> your app -> OAuth (use the tab matching SQUARE_ENVIRONMENT)
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Must exactly match the Redirect URL on that same OAuth tab
SQUARE_REDIRECT_URL=http://localhost:3000/api/square/callback
# 32 random bytes for encrypting Square tokens. Generate with: openssl rand -base64 32
SQUARE_TOKEN_KEY=

# Laptop only, for scripts/seed-sandbox.mjs (Credentials -> Sandbox access token)
SQUARE_SANDBOX_ACCESS_TOKEN=

# Webhooks (deployed site only): Square Developer console -> Webhooks -> Subscriptions
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://fojec-supermarket.vercel.app/api/square/webhook
# Any long random string; Vercel uses it to call the nightly sync. Generate with: openssl rand -hex 32
CRON_SECRET=
